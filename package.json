{
  "name": "hiratake-web",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "ひらたけの個人ウェブサイト",
  "homepage": "https://hiratake.dev/",
  "author": {
    "name": "Hiratake",
    "url": "https://hiratake.dev/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hiratake/hiratake-web.git"
  },
  "bugs": {
    "url": "https://github.com/Hiratake/hiratake-web/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@hiratake/textlint-rule-front-matter": "1.1.2",
    "@iconify-json/lucide": "1.2.118",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.90",
    "@iconify-json/vscode-icons": "1.2.67",
    "@nuxt/content": "3.15.0",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/scripts": "1.3.1",
    "@nuxt/ui": "4.10.0",
    "@nuxtjs/seo": "5.3.2",
    "@takumi-rs/core": "2.3.0",
    "@textlint-rule/textlint-rule-no-unmatched-pair": "2.0.4",
    "@vueuse/nuxt": "14.3.0",
    "better-sqlite3": "12.11.1",
    "eslint": "10.7.0",
    "feed": "6.0.0",
    "lefthook": "2.1.10",
    "nuxt": "4.4.8",
    "nuxt-llms": "0.2.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "textlint": "15.7.1",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "1.0.1",
    "textlint-rule-preset-ja-spacing": "3.0.2",
    "typescript": "6.0.3",
    "ufo": "1.6.4",
    "vue-tsc": "3.3.7"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm lint:script && pnpm lint:text",
    "lint:fix": "pnpm lint:script:fix && pnpm lint:text:fix",
    "lint:script": "eslint .",
    "lint:script:fix": "eslint . --fix",
    "lint:text": "textlint \"**/*.md\"",
    "lint:text:fix": "textlint \"**/*.md\" --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier \"**/!(*.md)\" -wu"
  }
}
